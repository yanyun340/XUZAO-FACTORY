# 复制为 backend/.env 后按需修改；本文件只允许占位值，不能填真实口令。
# 序造 XuZao 配置模板

# ---- 数据库 ----
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/xuzao_dev?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/xuzao_test?schema=public"

# ---- HTTP 服务 ----
NODE_ENV=development
PORT=3001
APP_ORIGIN="http://localhost:5173"

# ---- 会话 ----
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# ---- 演示初始化 ----
# 只在本地或隔离测试库使用；请自行设置一个非真实口令。
SEED_DEMO_PASSWORD="change-me-demo-password"

# ---- 嵌入式 PostgreSQL（未安装本地 Postgres 时）----
XUZAO_PG_PORT=55432
# 数据目录默认在用户目录下，避免中文路径问题
# XUZAO_PGDATA="C:/Users/you/.xuzao/pgdata"